FROM golang:1.26-alpine AS build

WORKDIR /src/sidecars/cockpit-cliproxy
COPY sidecars/cockpit-cliproxy ./
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cockpit-cliproxy .

FROM alpine:3.22

RUN apk add --no-cache ca-certificates wget \
  && adduser -D -H -u 10001 cockpit

COPY --from=build /out/cockpit-cliproxy /usr/local/bin/cockpit-cliproxy

USER cockpit
EXPOSE 1456

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- --header="Authorization: Bearer ${COCKPIT_CLIENT_API_KEY:-cockpit-local-key}" "http://127.0.0.1:${COCKPIT_PROXY_PORT:-1456}/v1/models" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/cockpit-cliproxy"]
