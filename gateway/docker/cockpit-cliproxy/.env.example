# Copy this file or pass it with:
# docker compose --env-file docker/cockpit-cliproxy/.env.example -f compose.cockpit-cliproxy.yml up -d --build

# The API key clients use when calling this local relay.
COCKPIT_CLIENT_API_KEY=cockpit-local-key

# Upstream OpenAI-compatible Responses endpoint.
COCKPIT_UPSTREAM_BASE_URL=https://api.openai.com/v1
COCKPIT_UPSTREAM_API_KEY=replace-me
COCKPIT_UPSTREAM_MODEL=gpt-5.5
COCKPIT_UPSTREAM_MODELS=gpt-5.5
COCKPIT_UPSTREAM_WIRE_API=responses

# Local bind settings. The compose file binds the host side to loopback by default.
COCKPIT_PROXY_BIND=127.0.0.1
COCKPIT_PROXY_PORT=1456

COCKPIT_PROVIDER_LABEL=Docker Provider
COCKPIT_DEBUG_LOGS=false
COCKPIT_SESSION_AFFINITY=true
COCKPIT_DISABLE_IMAGE_GENERATION=false
